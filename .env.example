# ===============================
# One OK Studio 本机部署配置
# ===============================
# 只需填需要的 Key。也可直接在应用的「设置」里填写：
# 开发态写入本文件的 .env，打包态写入 ~/.1okstudio/config.json。

# 必填
# -------------------------------
# 图像 / 视频 / 文本 主通道（韭菜盒子）
JIUCAIHEZI_API_KEY=your_jiucaihezi_api_key_here
# 配音 / 音色设计（TTS）走阿里云百炼，只有用到配音才需要填
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 数据位置（可选，默认 ~/.1okstudio）
# ONEOKSTUDIO_DATA_DIR=
# ONEOKSTUDIO_LOG_DIR=

# 文本模型通道（可选）
# 默认走上面的韭菜盒子 Key，不需要配置本项。
# 所有未显式指定模型的 AI 调用都用韭菜盒子网关。
#
# 只有临时需要切到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等) 时才设：
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b
#
# 历史通道（产品已不用，仅保留应急）:
# LLM_PROVIDER=dashscope

# ===============================
# API 端点覆盖（可选）
# ===============================
# 在应用「设置」里配置，不要写在这里。
# 韭菜盒子自身的 BASE_URL 被刻意从环境变量中移除（api.py 会 pop 掉它），
# 防止通过 .env 把请求指向其它地址。
