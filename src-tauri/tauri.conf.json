{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "One OK Studio",
  "version": "1.3.6",
  "identifier": "com.oneok.studio",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://localhost:3008",
    "beforeBuildCommand": "npm --prefix frontend run build:tauri",
    "beforeDevCommand": "cd frontend && npm run dev"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "One OK Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' http://127.0.0.1:* http://localhost:* data: blob: asset: https:; media-src 'self' http://127.0.0.1:* http://localhost:* data: blob: asset: https:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; font-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
