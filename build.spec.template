# -*- mode: python ; coding: utf-8 -*-
# PyInstaller Spec 文件模板
# 这是一个高级配置模板，供需要自定义打包的用户使用

import json
import os
import sys
from PyInstaller.utils.hooks import collect_all, collect_data_files, collect_submodules

block_cipher = None

# 项目根目录
ROOT_DIR = os.path.abspath('.')

# 版本号唯一来源是 package.json（前端 version.ts、tauri.conf.json 都跟它走），
# 别再在 spec 里写死 —— 这里以前写着 1.0.0。
APP_VERSION = json.load(
    open(os.path.join(ROOT_DIR, 'package.json'), encoding='utf-8')
)['version']

# 应用图标：单一源在 src-tauri/icons/（由 ./create_icon.sh 用 `npx tauri icon` 生成），
# 与 build_mac.sh / build_windows.ps1 用的是同一份。以前这里写的是仓库根的
# icon.ico / icon.icns —— 那两个文件从来没有存在过，打包一律用默认图标。
APP_ICON = 'src-tauri/icons/icon.icns' if sys.platform == 'darwin' else 'src-tauri/icons/icon.ico'

# 收集所有数据文件
datas = [
    ('static', 'static'),
    ('src/apps/comic_gen/style_presets.json', 'src/apps/comic_gen'),
    # 随包分发的 Skill：SkillPackageStore 从 <_MEIPASS>/skills 读内置包，
    # 这样用户不必每台机器重新上传。
    ('skills', 'skills'),
    # 运行时窗口图标：main.py 的 app_icon_path() 从 <_MEIPASS>/src-tauri/icons 取。
    # 不打包的话只能回落成 exe 里的 16px 小图标，任务栏会糊。
    (APP_ICON, 'src-tauri/icons'),
]

# 如果存在 .env 文件，也打包进去
if os.path.exists('.env'):
    datas.append(('.env', '.'))

# 收集所有隐藏导入
hiddenimports = [
    # Uvicorn
    'uvicorn.logging',
    'uvicorn.loops',
    'uvicorn.loops.auto',
    'uvicorn.protocols',
    'uvicorn.protocols.http',
    'uvicorn.protocols.http.auto',
    'uvicorn.protocols.websockets',
    'uvicorn.protocols.websockets.auto',
    'uvicorn.lifespan',
    'uvicorn.lifespan.on',
    # WebView
    'webview',
    # Web Framework
    'starlette',
    'starlette.staticfiles',
    'fastapi',
    'pydantic',
    # 阿里云 SDK（DashScope：文本模型与 TTS）
    'dashscope',
    # 其他
    'yaml',
    'dotenv',
    'httptools',
    'uvloop',
    'requests',
    'multipart',
]

# 自动收集包的所有内容
for package in ['uvicorn', 'fastapi', 'starlette', 'pydantic']:
    tmp_datas, tmp_binaries, tmp_hiddenimports = collect_all(package)
    datas += tmp_datas
    hiddenimports += tmp_hiddenimports

a = Analysis(
    ['main.py'],
    pathex=[ROOT_DIR],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=['.pyinstaller-hooks'],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # 排除不需要的模块以减小体积
        'matplotlib',
        'numpy',
        'PIL',
        'tkinter',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='One OK Studio',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,  # 使用 UPX 压缩（需要安装 UPX）
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,  # 不显示控制台窗口
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    # macOS 使用 .icns，Windows 使用 .ico
    icon=APP_ICON,
)

# macOS 应用包配置
if sys.platform == 'darwin':
    app = BUNDLE(
        exe,
        name='One OK Studio.app',
        icon=APP_ICON,
        # 与 src-tauri/tauri.conf.json 的 identifier、main.py 的 AppUserModelID
        # 保持一致 —— 三者不一致的话同一产品会被系统当成多个应用。
        bundle_identifier='com.oneok.studio',
        info_plist={
            'NSPrincipalClass': 'NSApplication',
            'NSHighResolutionCapable': 'True',
            'CFBundleShortVersionString': APP_VERSION,
            'CFBundleVersion': APP_VERSION,
        },
    )
